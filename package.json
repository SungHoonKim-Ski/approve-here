{
  "name": "approve-here",
  "version": "0.3.0",
  "description": "여러 Claude Code·Codex 세션의 승인 요청을 한 자리에서 처리하는 로컬 대기함. 훅 계약만 사용하며 판단은 사용자 정책이 갖는다.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "approve-here": "bin/approve-here.mjs"
  },
  "files": [
    "bin/",
    "core/",
    "hook/",
    "surfaces/tui/",
    "surfaces/web/",
    "README.md"
  ],
  "scripts": {
    "start": "node bin/approve-here.mjs start",
    "test": "node --test --test-timeout=15000 tests/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SungHoonKim-Ski/approve-here.git"
  },
  "homepage": "https://github.com/SungHoonKim-Ski/approve-here#readme",
  "bugs": "https://github.com/SungHoonKim-Ski/approve-here/issues",
  "keywords": [
    "claude-code",
    "codex",
    "hooks",
    "permission",
    "approval",
    "tmux",
    "menubar"
  ],
  "publishConfig": {
    "access": "public"
  }
}
